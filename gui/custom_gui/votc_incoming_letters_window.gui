			parentanchor = top|hcenter
			widgetanchor = top|hcenter
			position = { 0 850 }
			size = { 210 34 }
			text = votc_incoming_letters_close_option
			onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets votc_incoming_letters_window')]"
		}
	}
}
