window = {
	name = "votc_incoming_letters_window"
	size = { 700 940 }
	parentanchor = center
	movable = no
	layer = top
	filter_mouse = all
	alwaystransparent = no

	using = Background_Letter_No_Frame
	background = {
		using = Background_Area_Dark
		alpha = 0.92
	}

	# A container is the vanilla absolute-positioning parent.  Unlike widget,
	# it does not add the positions of successive children as a vertical flow.
	container = {
		name = "votc_incoming_letters_content"
		size = { 660 900 }
		parentanchor = top|left
		widgetanchor = top|left
		position = { 20 20 }

		widget = {
			size = { 660 56 }
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 0 }

			background = {
				using = Background_Header
				margin = { 2 0 }
			}
			background = {
				using = Background_Header_Pattern
				margin = { 2 0 }
			}

			text_single = {
				parentanchor = hcenter|vcenter
				widgetanchor = hcenter|vcenter
				text = votc_incoming_letters_settings_title
				using = Font_Type_Flavor
				using = Font_Size_Big
				align = center
			}

			button_close = {
				parentanchor = right|vcenter
				widgetanchor = right|vcenter
				position = { -8 0 }
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets votc_incoming_letters_window')]"
				tooltip = CLOSE_TOOLTIP
			}
		}

		text_single = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 68 }
			size = { 660 46 }
			text = votc_incoming_letters_settings_desc
			default_format = "#weak"
			multiline = yes
		}

		text_single = {
			visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_enabled').GetValue, '(CFixedPoint)0' )]"
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 122 }
			size = { 320 28 }
			text = votc_incoming_letters_status_enabled
			align = center
		}
		text_single = {
			visible = "[Not( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_enabled').GetValue, '(CFixedPoint)0' ) )]"
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 122 }
			size = { 320 28 }
			text = votc_incoming_letters_status_disabled
			align = center
		}
		text_single = {
			visible = "[Not( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_battle_reports_disabled').GetValue, '(CFixedPoint)0' ) )]"
			parentanchor = top|left
			widgetanchor = top|left
			position = { 340 122 }
			size = { 320 28 }
			text = votc_battle_reports_status_enabled
			align = center
		}
		text_single = {
			visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_battle_reports_disabled').GetValue, '(CFixedPoint)0' )]"
			parentanchor = top|left
			widgetanchor = top|left
			position = { 340 122 }
			size = { 320 28 }
			text = votc_battle_reports_status_disabled
			align = center
		}

		# The enable/disable button pair is laid out by an hbox (invisible
		# variants collapse) instead of hand-computed hcenter offsets, which
		# pushed the battle-report button past the window's right edge.
		hbox = {
			parentanchor = top|hcenter
			widgetanchor = top|hcenter
			position = { 0 150 }
			spacing = 20

			button_standard = {
				visible = "[Not( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_enabled').GetValue, '(CFixedPoint)0' ) )]"
				size = { 210 34 }
				text = votc_incoming_letters_enable_option
				onclick = "[GetScriptedGui('votc_incoming_letters_enable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_enabled').GetValue, '(CFixedPoint)0' )]"
				size = { 210 34 }
				text = votc_incoming_letters_disable_option
				onclick = "[GetScriptedGui('votc_incoming_letters_disable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				visible = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_battle_reports_disabled').GetValue, '(CFixedPoint)0' )]"
				size = { 210 34 }
				text = votc_battle_reports_enable_option
				onclick = "[GetScriptedGui('votc_battle_reports_enable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_standard = {
				visible = "[Not( GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('votc_battle_reports_disabled').GetValue, '(CFixedPoint)0' ) )]"
				size = { 210 34 }
				text = votc_battle_reports_disable_option
				onclick = "[GetScriptedGui('votc_battle_reports_disable_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		text_single = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 194 }
			size = { 660 30 }
			text = votc_incoming_letters_frequency_heading
			using = Font_Size_Medium
			align = center
		}

		widget = {
			parentanchor = top|left
			widgetanchor = top|left
			position = { 0 252 }
			size = { 660 24 }
			flowcontainer = {
				size = { 660 24 }
				direction = horizontal
				spacing = 8
				button_radio = {
					size = { 24 24 }
					parentanchor = vcenter
					frame = "[BoolTo1And2( EqualTo_CFixedPoint( GetPlayer.MakeScope.Var('votc_incoming_letters_frequency').GetValue, '(CFixedPoint)1' ) )]"
					onclick = "[GetScriptedGui('votc_incoming_letters_frequency_low_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				text_single = {
					size = { 628 24 }
					parentanchor = vcenter
					text = votc_incoming_letters_frequency_low_desc
					align = nobaseline
					multiline = yes
				}
			}
		}
