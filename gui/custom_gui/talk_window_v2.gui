		datacontext = "[GetGlobalVariable('mcc_character_10').GetCharacter]"
		parentanchor = bottom|hcenter
		position = { 120 230}
	}
	conversation_partner_v2 = {
		visible = "[GetGlobalVariable('mcc_character_11').IsSet]"
		datacontext = "[GetGlobalVariable('mcc_character_11').GetCharacter]"
		parentanchor = bottom|hcenter
		position = { 380 230}
