hbox = {
	name = "event_window_widget_talk_v2"
	layoutpolicy_horizontal = expanding
	margin = { 10 0 }
	
	state = {
        name = pause
        trigger_when = "[Not(IsGamePaused)]"
        on_start = "[OnPause]"
    }
	
	state = {
        name = widget_show
        trigger_on_create = yes
		
		on_start = "[EventWindowData.CopyToClipboard]"
		
				# P5: retain the fixed-name save snapshot for the desktop app before the
		# overlay widget is created. One ordered console batch keeps the save and
		# the gui.createwidget call out of the same-frame race (mod1 talk widget
		# parity). The init tail decides whether the app may parse the save.
		on_finish = "[ExecuteConsoleCommandsForced('save votc_context; gui.createwidget gui/custom_gui/talk_window_v2.gui talk_window_v2')]"
	}
	
	expand = {}

}
